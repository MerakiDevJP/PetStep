{
  "name": "Pet-Step UI - Angular 21 (Lab-Dev)",
  // Nos conectamos al Docker Compose que ya tienes en la raíz del laboratorio
  "dockerComposeFile": [
    "../../../../docker-compose.yml" // Ajusta la ruta relativa según tu estructura
  ],
  // Indicamos que el servicio principal para el DevContainer es 'angular'
  "service": "angular",
  "workspaceFolder": "/workspace/angular/PetStep/Frontend",
  "customizations": {
    "vscode": {
      "extensions": [
        "Angular.ng-template",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "mongodb.mongodb-vscode"
      ],
      "settings": {
        "terminal.integrated.shell.linux": "/bin/bash"
      }
    }
  },
  // Ejecutamos esto al crear el contenedor para asegurar que tengas el CLI de Angular
 "postCreateCommand": "mkdir -p ~/.npm-global && npm config set prefix '~/.npm-global' && export PATH=~/.npm-global/bin:$PATH && npm install -g @angular/cli@19.0.0",
  // Mantenemos abiertos los puertos definidos en tu compose
  "forwardPorts": [4200, 3000, 27017],
  "remoteUser": "node"
}